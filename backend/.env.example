# Copy to backend/.env. Never commit real secrets.
DATABASE_URL=postgresql+psycopg://gridlink:gridlink@localhost:5434/gridlink

# Optional: your personal ENTSO-E Transparency Platform security token.
# Without it the live ENTSO-E connector reports "awaiting credentials" (it never pretends to be connected).
ENTSOE_API_TOKEN=

# Optional: Gemini Developer API key (free tier) for AI error summaries. The pipeline never needs it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional background sync (APScheduler). Manual sync is the default workflow.
SCHEDULER_ENABLED=false

HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_RETRIES=3
HTTP_BACKOFF_BASE_SECONDS=1.0
LOG_LEVEL=INFO
